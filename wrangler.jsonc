{
  // Cloudflare Workers static assets. The build writes one HTML file per route (dist/qlik/index.html, ...) and dist/404.html.
  // "404-page": unknown URLs get dist/404.html with a real 404 status instead of the home page.
  "name": "merandatav3",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
