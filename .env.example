# Copy this file to .env (never commit .env) before running `npm run build`.
# Both values are read when the site is BUILT, so change them and build again.
#
# Contact form switch. Keep "false" until Resend, Cloudflare Turnstile and the server config file are set up
# (see docs/CONTACT_SETUP.md). While false, the contact section shows an email card instead of the form,
# so visitors never meet a form that cannot send.
#   false (default) -> email contact card (srivatsans@meridanta.com, "Send us an email" button, registered office)
#   true            -> the enquiry form, but only if VITE_TURNSTILE_SITE_KEY below is also set;
#                      with "true" and no key the build prints a warning and falls back to the card.
VITE_CONTACT_FORM_ENABLED=false

# Cloudflare Turnstile SITE key. It is public by design: it ends up in the built JavaScript.
# Get it from the Cloudflare dashboard -> Turnstile -> your widget for meridanta.com (see docs/CONTACT_SETUP.md).
# The SECRET key never goes here: it belongs only in ../meridanta-config.php on the server.
#
# For local testing without a real widget, Cloudflare publishes a test site key that always passes:
#   1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
