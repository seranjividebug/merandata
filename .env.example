# Copy this file to .env (never commit .env) and fill in the value before running `npm run build`.
#
# Cloudflare Turnstile SITE key. It is public by design: it ends up in the built JavaScript.
# Get it from the Cloudflare dashboard -> Turnstile -> your widget for meridanta.com (see docs/CONTACT_SETUP.md).
# The SECRET key never goes here: it belongs only in ../meridanta-config.php on the server.
#
# For local testing without a real widget, Cloudflare publishes a test site key that always passes:
#   1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
